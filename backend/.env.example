# Copy this file to ".env" (same folder) and fill it in. Never commit .env.
# These keys stay on the server. They are never sent to the browser.

# Vaani Voice AI key (platform.vaani.dev -> API Keys). Looks like vaani_xxxxxxxx
VAANI_API_KEY=vaani_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Filled in for you by:  python setup_vaani_agent.py --base-url https://YOUR-NGROK-URL
VAANI_AGENT_ID=

# Anakin key (anakin.io dashboard -> API keys). Used for live web search and shop prices.
ANAKIN_API_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret the voice agent's tools send in the X-Tool-Secret header.
# Pick your own random value. If you change it later, run setup_vaani_agent.py with --update.
TOOL_SECRET=change-me-to-something-random

# Password for the teacher page (http://localhost:5173/#teacher)
TEACHER_KEY=change-me
